	(text "ESP32 DevKit asennetaan kahteen 1x19 naarasliittimeen: J8 vasen ja J9 oikea, rivivali 25.4 mm. Pinout korjattu annetun ESP32-WROOM-32 38-pin kuvan mukaan: J8 pin1=3V3, J8 pin19=USB_5V, J9 pin1=GND, J9 pin13=GPIO4."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "110e9b30-62f5-4093-ac1d-2adda2b2a0f7")
	)
	(text "J4 KORJATTU: pin1 AO -> R2 -> GPIO34, pin2 GND, pin3 3V3. C3 on GPIO34 -> GND."
		(exclude_from_sim no)
		(at 20 48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "11111111-2222-4333-8444-555555555555")
	)
	(text "Kytke ulkoisesti: J1 pin1 (+) -> J10 COM, J10 NO -> J2 pin1 (PUMP+). J1 pin2/J2 pin2 = GND."
		(exclude_from_sim no)
		(at 75 237 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1831cc0d-d823-4569-a86f-d884e3bf2b25")
	)
	(text "K1 on vain relemoduulin KUORMAKONTAKTIEN esitys. Jos käytät valmista relemoduulia, johdota J10 moduulin ruuviliittimeen."
		(exclude_from_sim no)
		(at 75 230 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1cd6f38f-3e7a-4051-95dc-df00722712c4")
	)
	(text "J3 relemoduuli: pin1 IN, pin2 GND, pin3 VCC=USB_5V. Varmista moduulin oma pinijärjestys."
		(exclude_from_sim no)
		(at 20 34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4ac154b2-9819-4aa8-b049-2f6a1f1362f9")
	)
	(text "Pumppu: J1 + -> J10/K1 COM, J10/K1 NO -> J2 +, J1/J2 miinus -> GND."
		(exclude_from_sim no)
		(at 20 41 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "50e76752-ea64-4075-8f9d-8b24f0727ab7")
	)
	(text "KORJATTU: ESP32 DevKit on nyt kahtena 1x19 liittimena J8/J9, kuten PCB:n naarasrimat."
		(exclude_from_sim no)
		(at 20 20 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "6e569dd2-1aef-4e18-a6fd-e64b9cf1ce24")
	)
